-void craft_reservation_index::rebuild_for_craft( const item_location &loc )
-{
-    if( !loc || !loc->is_craft() ) {
-        return;
-    }
-    const item &craft = *loc;
-    const int64_t token = craft.peek_reservation_owner_token();
